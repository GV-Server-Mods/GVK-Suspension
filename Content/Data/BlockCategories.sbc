<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CategoryClasses>
		<!-- Group primaries only: a category shows every listed block as its own icon, so listing one block per group shows one icon with the + mark (StrictSearch true, or the group's other sizes are added back). StrictSearch here only counts if this mod's GVK category loads first -->
		<Category xsi:type="MyObjectBuilder_GuiBlockCategoryDefinition">
			<Id>
				<TypeId>GuiBlockCategoryDefinition</TypeId>
				<SubtypeId/>
			</Id>
			<DisplayName>GV Kharak Items</DisplayName>
			<Name>GVK</Name>
			<StrictSearch>true</StrictSearch>
			<ItemIds>
				<string>MotorSuspension/LG_3x3_Lifted_Suspension_Left</string>
				<string>MotorSuspension/LG_3x3_Lifted_Suspension_Right</string>
				<string>MotorSuspension/LG_3x3_Offroad_Lifted_Suspension_Left</string>
				<string>MotorSuspension/LG_3x3_Offroad_Lifted_Suspension_Right</string>
				<string>MotorSuspension/LiftedShortSuspension3x3mirrored</string>
				<string>MotorSuspension/LiftedShortSuspension3x3</string>
				<string>MotorSuspension/LiftedShortOffroadSuspension3x3mirrored</string>
				<string>MotorSuspension/LiftedShortOffroadSuspension3x3</string>
				<string>MotorSuspension/Suspension7x7mirrored</string>
				<string>MotorSuspension/Suspension7x7</string>
			</ItemIds>
		</Category>
		<!-- Added to Keen's Large Blocks tab -->
		<Category xsi:type="MyObjectBuilder_GuiBlockCategoryDefinition">
			<Id>
				<TypeId>GuiBlockCategoryDefinition</TypeId>
				<SubtypeId/>
			</Id>
			<DisplayName>DisplayName_Category_LargeBlocks</DisplayName>
			<Name>Section1_Position1_LargeBlocks</Name>
			<StrictSearch>true</StrictSearch>
			<ItemIds>
				<string>MotorSuspension/LG_3x3_Lifted_Suspension_Left</string>
				<string>MotorSuspension/LG_3x3_Lifted_Suspension_Right</string>
				<string>MotorSuspension/LG_3x3_Offroad_Lifted_Suspension_Left</string>
				<string>MotorSuspension/LG_3x3_Offroad_Lifted_Suspension_Right</string>
				<string>MotorSuspension/LiftedShortSuspension3x3mirrored</string>
				<string>MotorSuspension/LiftedShortSuspension3x3</string>
				<string>MotorSuspension/LiftedShortOffroadSuspension3x3mirrored</string>
				<string>MotorSuspension/LiftedShortOffroadSuspension3x3</string>
			</ItemIds>
		</Category>
		<!-- Added to Keen's Small Blocks tab (the small Lifted Short has no small grid version) -->
		<Category xsi:type="MyObjectBuilder_GuiBlockCategoryDefinition">
			<Id>
				<TypeId>GuiBlockCategoryDefinition</TypeId>
				<SubtypeId/>
			</Id>
			<DisplayName>DisplayName_Category_SmallBlocks</DisplayName>
			<Name>Section1_Position1_SmallBlocks</Name>
			<StrictSearch>true</StrictSearch>
			<ItemIds>
				<string>MotorSuspension/SG_3x3_Lifted_Suspension_Left</string>
				<string>MotorSuspension/SG_3x3_Lifted_Suspension_Right</string>
				<string>MotorSuspension/SG_3x3_Offroad_Lifted_Suspension_Left</string>
				<string>MotorSuspension/SG_3x3_Offroad_Lifted_Suspension_Right</string>
			</ItemIds>
		</Category>
		<!-- GV Kharak Items, Propulsion; the 7x7 shows as two single icons (it is a size inside Keen's suspension groups, so it has no + here) -->
		<Category xsi:type="MyObjectBuilder_GuiBlockCategoryDefinition">
			<Id>
				<TypeId>GuiBlockCategoryDefinition</TypeId>
				<SubtypeId/>
			</Id>
			<DisplayName>   Propulsion</DisplayName>
			<Name>GVK_Propulsion</Name>
			<StrictSearch>true</StrictSearch>
			<ItemIds>
				<string>MotorSuspension/LG_3x3_Lifted_Suspension_Left</string>
				<string>MotorSuspension/LG_3x3_Lifted_Suspension_Right</string>
				<string>MotorSuspension/LG_3x3_Offroad_Lifted_Suspension_Left</string>
				<string>MotorSuspension/LG_3x3_Offroad_Lifted_Suspension_Right</string>
				<string>MotorSuspension/LiftedShortSuspension3x3mirrored</string>
				<string>MotorSuspension/LiftedShortSuspension3x3</string>
				<string>MotorSuspension/LiftedShortOffroadSuspension3x3mirrored</string>
				<string>MotorSuspension/LiftedShortOffroadSuspension3x3</string>
				<string>MotorSuspension/Suspension7x7mirrored</string>
