<?xml version="1.0" encoding="UTF-8"?>
<Definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<CubeBlocks>
		<!-- ==============================================================

                      Large Grid Suspension (Short Tracks)

=============================================================== -->
		<Definition xsi:type="MyObjectBuilder_MotorSuspensionDefinition">
			<Id>
				<TypeId>MotorSuspension</TypeId>
				<SubtypeId>ShortTrackSuspension5x5mirrored</SubtypeId>
			</Id>
			<DisplayName>5x5 Short Track Suspension Left</DisplayName>
			<Icon>Textures\Icons\5x5_Lifted_Short_Track_Suspension_Left.dds</Icon>
			<Description>Description_Suspension</Description>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="2" y="2" z="2"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Cubes\Large\MotorSuspensionCompactLarge.mwm</Model>
			<UseModelIntersection>true</UseModelIntersection>
			<SilenceableByShipSoundSystem>true</SilenceableByShipSoundSystem>
			<DeformationRatio>0.1</DeformationRatio>
			<UsesDeformation>false</UsesDeformation>
			<Components>
				<Component Subtype="SteelPlate" Count="200"/>
				<Component Subtype="Construction" Count="200"/>
				<Component Subtype="LargeTube" Count="100"/>
				<Component Subtype="Motor" Count="100"/>
				<Component Subtype="SmallTube" Count="150"/>
				<Component Subtype="SteelPlate" Count="150"/>
			</Components>
			<CriticalComponent Subtype="Motor" Index="0"/>
			<MountPoints>
				<MountPoint Side="Bottom" StartX="0" StartY="0.1" EndX="2" EndY="1.9" Default="true"/>
				<MountPoint Side="Front" StartX="0" StartY="0.1" EndX="2" EndY="1"/>
				<MountPoint Side="Left" StartX="0" StartY="0" EndX="2" EndY="0.5"/>
				<MountPoint Side="Right" StartX="0" StartY="0" EndX="2" EndY="0.5"/>
				<MountPoint Side="Back" StartX="0" StartY="0.1" EndX="2" EndY="1"/>
			</MountPoints>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\MotorSuspensionCompactLargeConstruction_1.mwm"/>
				<Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\MotorSuspensionCompactLargeConstruction_2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\MotorSuspensionCompactLargeConstruction_3.mwm"/>
			</BuildProgressModels>
			<VoxelPlacement>
				<StaticMode>
					<PlacementMode>OutsideVoxel</PlacementMode>
					<MaxAllowed>0.2</MaxAllowed>
					<MinAllowed>0</MinAllowed>
				</StaticMode>
				<DynamicMode>
					<PlacementMode>OutsideVoxel</PlacementMode>
					<MaxAllowed>0.2</MaxAllowed>
					<MinAllowed>0.01</MinAllowed>
				</DynamicMode>
			</VoxelPlacement>
			<BlockPairName>ShortTrackSuspension5x5mirrored</BlockPairName>
			<MirroringY>ZThenOffsetX</MirroringY>
			<MirroringZ>YThenOffsetX</MirroringZ>
			<MirroringBlock>ShortTrackSuspension5x5</MirroringBlock>
			<EdgeType>Light</EdgeType>
			<BuildTimeSeconds>30</BuildTimeSeconds>
			<PrimarySound>BlockWheel5x5</PrimarySound>
			<ResourceSinkGroup>Utility</ResourceSinkGroup>
			<RequiredPowerInput>3</RequiredPowerInput>
			<RequiredIdlePowerInput>0.02</RequiredIdlePowerInput>
			<PropulsionForce>1000000</PropulsionForce>
			<MaxForceMagnitude>1E9</MaxForceMagnitude>
			<DangerousTorqueThreshold>3.36E+07</DangerousTorqueThreshold>
			<RotorPart>RealTrackWheel5x5</RotorPart>
			<MinHeight>-2.00</MinHeight>
			<MaxHeight>1.5</MaxHeight>
			<DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
			<DamagedSound>ParticleHeavyMech</DamagedSound>
			<SafetyDetach>5</SafetyDetach>
			<SafetyDetachMax>5</SafetyDetachMax>
			<AxleFriction>200000</AxleFriction>
			<SteeringSpeed>0.005</SteeringSpeed>
			<AirShockMinSpeed>10</AirShockMinSpeed>
			<AirShockMaxSpeed>25</AirShockMaxSpeed>
			<AirShockActivationDelay>60</AirShockActivationDelay>
			<DestroyEffect>BlockDestroyedExplosion_Large3X</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<IsAirTight>false</IsAirTight>
			<PCU>50</PCU>
			<TargetingGroups>
				<string>Propulsion</string>
			</TargetingGroups>
			<GuiVisible>false</GuiVisible>
		</Definition>
