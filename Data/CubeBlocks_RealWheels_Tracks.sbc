<?xml version="1.0" encoding="UTF-8"?>
<Definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<CubeBlocks>
		<!-- Real Wheels -->
		<!-- Large 1x1 -->
		<Definition>
			<Id>
				<TypeId>Wheel</TypeId>
				<SubtypeId>RealTrackWheel1x1</SubtypeId>
			</Id>
			<DisplayName>DisplayName_Block_Wheel1x1</DisplayName>
			<Icon>Textures\GUI\Icons\Cubes\WheelSuspension1x1Right.dds</Icon>
			<Description>Description_Wheel</Description>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="1"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\TankWheel1x1.mwm</Model>
			<UseModelIntersection>true</UseModelIntersection>
			<PhysicalMaterial>Wheel</PhysicalMaterial>
			<Components>
				<Component Subtype="SteelPlate" Count="30"/>
				<Component Subtype="LargeTube" Count="30"/>
				<Component Subtype="Construction" Count="90"/>
				<Component Subtype="SteelPlate" Count="60"/>
			</Components>
			<CriticalComponent Subtype="LargeTube" Index="0"/>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\TankWheel1x1_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.66" File="Models\TankWheel1x1_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\TankWheel1x1_BS3.mwm"/>
			</BuildProgressModels>
			<VoxelPlacement>
				<!--Possible settings Both,InVoxel,OutsideVoxel,Volumetric. If volumetric set than MaxAllowed and MinAllowed will be used.-->
				<StaticMode>
					<PlacementMode>OutsideVoxel</PlacementMode>
					<MaxAllowed>0.2</MaxAllowed>
					<MinAllowed>0</MinAllowed>
				</StaticMode>
				<DynamicMode>
					<PlacementMode>OutsideVoxel</PlacementMode>
					<MaxAllowed>0.2</MaxAllowed>
					<MinAllowed>0.01</MinAllowed>
				</DynamicMode>
			</VoxelPlacement>
			<WheelPlacementCollider>
				<ColliderDiameter>0.01</ColliderDiameter>
				<ColliderHeight>0.01</ColliderHeight>
				<ColliderOffset>0</ColliderOffset>
			</WheelPlacementCollider>
			<MountPoints>
				<MountPoint Side="Back" StartX="0" StartY="0" EndX="0" EndY="0" Enabled="false"/>
			</MountPoints>
			<BlockPairName>RealTrackWheel1x1</BlockPairName>
			<UsesDeformation>false</UsesDeformation>
			<DeformationRatio>0.3</DeformationRatio>
			<MirroringY>Z</MirroringY>
			<MirroringZ>Y</MirroringZ>
			<MirroringBlock>RealTrackWheel1x1</MirroringBlock>
			<EdgeType>Light</EdgeType>
			<BuildTimeSeconds>15</BuildTimeSeconds>
			<InventorySize>
				<X>2.5</X>
				<Y>2.5</Y>
				<Z>2.5</Z>
			</InventorySize>
			<DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
			<DamagedSound>ParticleHeavyMech</DamagedSound>
			<DestroyEffect>BlockDestroyed_Medium</DestroyEffect>
			<DestroySound>PoofExplosionCat2</DestroySound>
			<PCU>25</PCU>
			<IsAirTight>false</IsAirTight>
			<GuiVisible>false</GuiVisible>
			<Public>false</Public>
		</Definition>
		<!-- Large 2x2 -->
		<Definition>
			<Id>
				<TypeId>Wheel</TypeId>
				<SubtypeId>RealTrackWheel2x2</SubtypeId>
			</Id>
			<DisplayName>DisplayName_Block_Wheel2x2</DisplayName>
			<Icon>Textures\GUI\Icons\Cubes\WheelSuspension2x2Right.dds</Icon>
			<Description>Description_Wheel</Description>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="2" y="1" z="2"/>
			<MechanicalTopInitialPlacementOffset x="-1.25" y="0" z="-1.25"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\TankWheel2x2.mwm</Model>
			<UseModelIntersection>true</UseModelIntersection>
			<PhysicalMaterial>Wheel</PhysicalMaterial>
			<Components>
				<Component Subtype="SteelPlate" Count="45"/>
				<Component Subtype="LargeTube" Count="45"/>
				<Component Subtype="Construction" Count="90"/>
				<Component Subtype="SteelPlate" Count="90"/>
			</Components>
			<CriticalComponent Subtype="LargeTube" Index="0"/>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\TankWheel2x2_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.66" File="Models\TankWheel2x2_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\TankWheel2x2_BS3.mwm"/>
			</BuildProgressModels>
			<MountPoints>
				<MountPoint Side="Back" StartX="1" StartY="1" EndX="1" EndY="1" Enabled="false"/>
			</MountPoints>
			<VoxelPlacement>
				<!--Possible settings Both,InVoxel,OutsideVoxel,Volumetric. If volumetric set than MaxAllowed and MinAllowed will be used.-->
				<StaticMode>
					<PlacementMode>OutsideVoxel</PlacementMode>
					<MaxAllowed>0.2</MaxAllowed>
					<MinAllowed>0</MinAllowed>
				</StaticMode>
				<DynamicMode>
					<PlacementMode>OutsideVoxel</PlacementMode>
					<MaxAllowed>0.2</MaxAllowed>
					<MinAllowed>0.01</MinAllowed>
				</DynamicMode>
			</VoxelPlacement>
			<WheelPlacementCollider>
				<ColliderDiameter>0.01</ColliderDiameter>
				<ColliderHeight>0.01</ColliderHeight>
				<ColliderOffset>0</ColliderOffset>
			</WheelPlacementCollider>
			<BlockPairName>RealTrackWheel2x2</BlockPairName>
			<UsesDeformation>false</UsesDeformation>
			<DeformationRatio>0.3</DeformationRatio>
			<MirroringY>Z</MirroringY>
			<MirroringZ>Y</MirroringZ>
			<MirroringBlock>RealTrackWheel2x2</MirroringBlock>
			<EdgeType>Light</EdgeType>
			<BuildTimeSeconds>15</BuildTimeSeconds>
			<InventorySize>
				<X>2.5</X>
				<Y>2.5</Y>
				<Z>2.5</Z>
			</InventorySize>
			<DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
			<DamagedSound>ParticleHeavyMech</DamagedSound>
			<DestroyEffect>BlockDestroyed_Large</DestroyEffect>
			<DestroySound>PoofExplosionCat3</DestroySound>
			<PCU>25</PCU>
			<IsAirTight>false</IsAirTight>
			<GuiVisible>false</GuiVisible>
			<Public>false</Public>
		</Definition>
		<!-- Large 3x3 -->
		<Definition>
			<Id>
				<TypeId>Wheel</TypeId>
				<SubtypeId>RealTrackWheel</SubtypeId>
			</Id>
			<DisplayName>DisplayName_Block_Wheel3x3</DisplayName>
			<Icon>Textures\GUI\Icons\Cubes\WheelSuspension3x3Right.dds</Icon>
			<Description>Description_Wheel</Description>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="3" y="2" z="3"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\TankWheel3x3.mwm</Model>
			<UseModelIntersection>true</UseModelIntersection>
			<PhysicalMaterial>Wheel</PhysicalMaterial>
			<Components>
				<Component Subtype="SteelPlate" Count="60"/>
				<Component Subtype="LargeTube" Count="60"/>
				<Component Subtype="Construction" Count="150"/>
				<Component Subtype="SteelPlate" Count="150"/>
			</Components>
			<CriticalComponent Subtype="LargeTube" Index="0"/>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\TankWheel3x3_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.66" File="Models\TankWheel3x3_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\TankWheel3x3_BS3.mwm"/>
			</BuildProgressModels>
			<VoxelPlacement>
				<!--Possible settings Both,InVoxel,OutsideVoxel,Volumetric. If volumetric set than MaxAllowed and MinAllowed will be used.-->
				<StaticMode>
					<PlacementMode>OutsideVoxel</PlacementMode>
					<MaxAllowed>0.2</MaxAllowed>
					<MinAllowed>0</MinAllowed>
				</StaticMode>
				<DynamicMode>
					<PlacementMode>OutsideVoxel</PlacementMode>
					<MaxAllowed>0.2</MaxAllowed>
					<MinAllowed>0.01</MinAllowed>
				</DynamicMode>
			</VoxelPlacement>
			<WheelPlacementCollider>
				<ColliderDiameter>0.01</ColliderDiameter>
				<ColliderHeight>0.01</ColliderHeight>
				<ColliderOffset>0</ColliderOffset>
			</WheelPlacementCollider>
			<MountPoints>
				<MountPoint Side="Back" StartX="0" StartY="0" EndX="0" EndY="0" Enabled="false"/>
			</MountPoints>
			<BlockPairName>RealTrackWheel</BlockPairName>
			<UsesDeformation>false</UsesDeformation>
			<DeformationRatio>0.3</DeformationRatio>
			<MirroringY>Z</MirroringY>
			<MirroringZ>Y</MirroringZ>
			<MirroringBlock>RealTrackWheel</MirroringBlock>
			<EdgeType>Light</EdgeType>
			<BuildTimeSeconds>20</BuildTimeSeconds>
			<InventorySize>
				<X>2.5</X>
				<Y>2.5</Y>
				<Z>2.5</Z>
			</InventorySize>
			<DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
			<DamagedSound>ParticleHeavyMech</DamagedSound>
			<DestroyEffect>BlockDestroyed_Large</DestroyEffect>
			<DestroySound>PoofExplosionCat3</DestroySound>
			<PCU>25</PCU>
			<IsAirTight>false</IsAirTight>
			<GuiVisible>false</GuiVisible>
			<Public>false</Public>
		</Definition>
		<!-- Large 5x5 -->
		<Definition>
			<Id>
				<TypeId>Wheel</TypeId>
				<SubtypeId>RealTrackWheel5x5</SubtypeId>
			</Id>
			<DisplayName>DisplayName_Block_Wheel5x5</DisplayName>
			<Icon>Textures\GUI\Icons\Cubes\WheelSuspension5x5Right.dds</Icon>
			<Description>Description_Wheel</Description>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="5" y="3" z="5"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\TankWheel5x5.mwm</Model>
			<UseModelIntersection>true</UseModelIntersection>
			<PhysicalMaterial>Wheel</PhysicalMaterial>
			<Components>
				<Component Subtype="SteelPlate" Count="90"/>
				<Component Subtype="LargeTube" Count="90"/>
				<Component Subtype="Construction" Count="210"/>
				<Component Subtype="SteelPlate" Count="300"/>
			</Components>
			<CriticalComponent Subtype="LargeTube" Index="0"/>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\TankWheel5x5_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.66" File="Models\TankWheel5x5_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\TankWheel5x5_BS3.mwm"/>
