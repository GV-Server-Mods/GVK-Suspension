		<!-- ==============================================================

                      Large Grid Suspension

=============================================================== -->
		<Definition xsi:type="MyObjectBuilder_MotorSuspensionDefinition">
			<Id>
				<TypeId>MotorSuspension</TypeId>
				<SubtypeId>LG_5x5_Offroad_Lifted_Suspension_Left</SubtypeId>
			</Id>
			<DisplayName>5x5 Offroad Lifted Wheel Suspension Left</DisplayName>
			<Icon>Textures\Icons\5x5_Lifted_Offroad_Suspension_Left.dds</Icon>
			<Description>Lifted suspension allows your ground vehicles to have a significant increase in ground clearance while also increasing vertical height limit.</Description>
			<CubeSize>Large</CubeSize>
			<GuiVisible>false</GuiVisible>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="2" y="3" z="2"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\LG_5x5_Lifted_Suspension_ZANTULO.mwm</Model>
			<UseModelIntersection>true</UseModelIntersection>
			<SilenceableByShipSoundSystem>true</SilenceableByShipSoundSystem>
			<DeformationRatio>0.1</DeformationRatio>
			<UsesDeformation>false</UsesDeformation>
			<Components>
				<Component Subtype="SteelPlate" Count="200"/>
				<Component Subtype="Construction" Count="200"/>
				<Component Subtype="LargeTube" Count="100"/>
				<Component Subtype="Motor" Count="100"/>
				<Component Subtype="SmallTube" Count="150"/>
				<Component Subtype="SteelPlate" Count="150"/>
			</Components>
			<CriticalComponent Subtype="Motor" Index="0"/>
			<MountPoints>
				<MountPoint Side="Front" StartX="0.00" StartY="0.00" EndX="2.0" EndY="1.0"/>
				<MountPoint Side="Back" StartX="0.00" StartY="0.00" EndX="2.0" EndY="1.0"/>
				<MountPoint Side="Left" StartX="0.00" StartY="0.00" EndX="2.0" EndY="1.0"/>
				<MountPoint Side="Right" StartX="0.00" StartY="0.00" EndX="2.0" EndY="1.0"/>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="2.0" EndY="2.0" Default="true"/>
			</MountPoints>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\LG_5x5_Lifted_Suspension_ZANTULO_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\LG_5x5_Lifted_Suspension_ZANTULO_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\LG_5x5_Lifted_Suspension_ZANTULO_BS3.mwm"/>
			</BuildProgressModels>
			<VoxelPlacement>
				<StaticMode>
					<PlacementMode>OutsideVoxel</PlacementMode>
					<MaxAllowed>0.2</MaxAllowed>
					<MinAllowed>0</MinAllowed>
				</StaticMode>
				<DynamicMode>
					<PlacementMode>OutsideVoxel</PlacementMode>
					<MaxAllowed>0.2</MaxAllowed>
					<MinAllowed>0.01</MinAllowed>
				</DynamicMode>
			</VoxelPlacement>
			<BlockPairName>5x5_Offroad_Lifted_Suspension_Left</BlockPairName>
			<MirroringY>ZThenOffsetX</MirroringY>
			<MirroringZ>YThenOffsetX</MirroringZ>
			<MirroringBlock>LG_5x5_Offroad_Lifted_Suspension_Right</MirroringBlock>
			<EdgeType>Light</EdgeType>
			<BuildTimeSeconds>40</BuildTimeSeconds>
			<PrimarySound>BlockWheel5x5</PrimarySound>
			<ResourceSinkGroup>Utility</ResourceSinkGroup>
			<RequiredPowerInput>15</RequiredPowerInput>
			<RequiredIdlePowerInput>0.02</RequiredIdlePowerInput>
			<PropulsionForce>1000000</PropulsionForce>
			<MaxForceMagnitude>1E9</MaxForceMagnitude>
			<DangerousTorqueThreshold>3.36E+07</DangerousTorqueThreshold>
			<RotorPart>OffroadRealWheel5x5mirrored</RotorPart>
			<MinHeight>-2.0</MinHeight>
			<MaxHeight>2.0</MaxHeight>
			<DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
			<DamagedSound>ParticleHeavyMech</DamagedSound>
			<SafetyDetach>5</SafetyDetach>
			<SafetyDetachMax>5</SafetyDetachMax>
			<AxleFriction>200000</AxleFriction>
			<SteeringSpeed>0.010</SteeringSpeed>
			<AirShockMinSpeed>10</AirShockMinSpeed>
			<AirShockMaxSpeed>25</AirShockMaxSpeed>
			<AirShockActivationDelay>60</AirShockActivationDelay>
			<DestroyEffect>BlockDestroyedExplosion_Large3X</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>50</PCU>
			<DLC>ScrapRace</DLC>
		</Definition>
